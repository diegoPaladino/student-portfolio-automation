# Publish only reviewed source, configuration, tests and non-personal docs.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/app.py
!/iniciar.ps1
!/src/
!/config/
!/tests/
!/docs/
/src/*
!/src/*.py
/config/*
!/config/catalog.json
!/config/streamlit.toml
/tests/*
!/tests/test_*.py
/docs/*
!/docs/ARQUITETURA.md
!/docs/PLANO_MVPS.md
!/docs/VALIDACAO.md

# Local environments, caches, temporary files and logs.
.venv/
venv/
env/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]
*.tmp
*.temp
*.bak
*.log
*.swp
~$*
.DS_Store
Thumbs.db
.coverage
htmlcov/
build/
dist/

# Secrets and machine-specific settings.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*credentials*
*secrets*
.aws/
.ssh/
.codex/
.agents/

# Student data, photographs, generated portfolios and private documents.
data/
images/
photos/
fotos/
outputs/
backups/
*.db
*.sqlite
*.sqlite3
*.sqlite3-*
*.jpg
*.jpeg
*.png
*.webp
*.heic
*.heif
*.gif
*.tif
*.tiff
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.csv
*.zip
*.7z

# Operational logs and diagnostic artifacts (including rotated files).
logs/
*.jsonl
*.log.*
!/AGENTS.md
